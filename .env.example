# DESNWORLD engine configuration (copy to .env — never commit .env)

# --- Required for real scenario generation ---
# Any OpenAI-compatible Chat Completions endpoint works.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# --- Optional: request timeout in seconds (default 90) ---
# LLM_TIMEOUT_SECONDS=90

# --- Optional: local dev API server (engine/desnworld/server.py) ---
# DESNWORLD_HOST=127.0.0.1
# DESNWORLD_PORT=8787

# --- Market data honesty flag (stock-market education module) ---
# The DESNWORLD prototype ships with NO live market-data adapter enabled.
# Leave unset. If you configure a licensed market-data adapter of your own,
# set this to "true" ONLY once the adapter actually queried live sources in
# the current run — the engine will then mark reports accordingly.
# MARKET_DATA_CHECKED=false

# In GitHub Actions, the same values are supplied via repository secrets
# (LLM_API_KEY required; LLM_BASE_URL / LLM_MODEL_NAME optional).
